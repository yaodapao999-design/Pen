{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/plan_docs_sync.py\"",
            "statusMessage": "Plans 下级文档同步检查…"
          }
        ]
      }
    ]
  }
}
